# ==============================================================================
# ENMAR Production Environment Variables (.env)
# ==============================================================================

NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. LIVE DATABASE CONNECTION (TiDB Cloud / MySQL)
# ------------------------------------------------------------------------------
# TiDB Cloud Serverless URL Format (SSL Enabled):
# Example: mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<database_name>?sslaccept=strict
DATABASE_URL="mysql://YOUR_TIDB_USER:YOUR_TIDB_PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/enmar?sslaccept=strict"

# ------------------------------------------------------------------------------
# 2. SITE & AUTHENTICATION URLS (Your Live Domain)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXTAUTH_URL="https://yourdomain.com"

# ------------------------------------------------------------------------------
# 3. SECURITY KEYS & ENCRYPTION SECRETS
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="enmar_nextauth_secret_key_2026_super_secure"
ENCRYPTION_SECRET="enmar_secure_master_aes_vault_key_2026_bd"
JWT_SECRET="enmar_jwt_secret_key_2026_production"

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI & THIRD-PARTY GATEWAY KEYS
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=""
