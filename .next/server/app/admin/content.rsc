1f:{"metadata":[["$","title","0",{"children":"ENMAR — 100% Pure Organic Food & Pantry Essentials | খাঁটি অর্গানিক খাদ্য"}],["$","meta","1",{"name":"description","content":"বাংলাদেশের প্রিমিয়াম অর্গানিক ফুড ব্র্যান্ড। সুন্দরবনের খাঁটি মধু, গাওয়া ঘি, কাঠের ঘানির সরিষার তেল, অর্গানিক চাল, ডাল ও মশলা। সারাদেশে দ্রুত হোম ডেলিভারি ও ক্যাশ অন ডেলিভারি।"}],["$","link","2",{"rel":"author","href":"https://enmar.shop"}],["$","meta","3",{"name":"author","content":"ENMAR Organic"}],["$","link","4",{"rel":"manifest","href":"/manifest.webmanifest","crossOrigin":"$undefined"}],["$","meta","5",{"name":"keywords","content":"ENMAR,অর্গানিক ফুড বাংলাদেশ,খাঁটি মধু,সুন্দরবনের মধু,গাওয়া ঘি,খাঁটি সরিষার তেল,কাঠের ঘানির তেল,কালোজিরা তেল,অর্গানিক খাদ্য,Organic Food Bangladesh,Pure Honey BD,Deshi Ghee Dhaka,Cold Pressed Mustard Oil,Organic Grocery Bangladesh,Health Food Store Dhaka,Buy Pure Honey Online"}],["$","meta","6",{"name":"creator","content":"ENMAR Bangladesh"}],["$","meta","7",{"name":"publisher","content":"ENMAR Organic Food"}],["$","meta","8",{"name":"robots","content":"index, follow"}],["$","meta","9",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","link","10",{"rel":"canonical","href":"https://enmar.shop"}],["$","link","11",{"rel":"alternate","hrefLang":"bn-BD","href":"https://enmar.shop"}],["$","link","12",{"rel":"alternate","hrefLang":"en-US","href":"https://enmar.shop"}],["$","meta","13",{"name":"format-detection","content":"telephone=no, address=no, email=no"}],["$","meta","14",{"property":"og:title","content":"ENMAR — 100% Pure Organic Food & Pantry Essentials | খাঁটি অর্গানিক খাদ্য"}],["$","meta","15",{"property":"og:description","content":"সুন্দরবনের খাঁটি মধু, গাওয়া ঘি, কাঠের ঘানির সরিষার তেল ও অর্গানিক খাদ্য সম্ভার। ১০০% বিশুদ্ধতার নিশ্চয়তা।"}],["$","meta","16",{"property":"og:url","content":"https://enmar.shop"}],["$","meta","17",{"property":"og:site_name","content":"ENMAR — Pure Organic Food Bangl